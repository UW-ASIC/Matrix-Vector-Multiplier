.param mc_mm_switch=0
.param mc_pr_switch=0
.include /home/david/.volare/sky130A/libs.tech/ngspice/corners/tt.spice
.include /home/david/.volare/sky130A/libs.tech/ngspice/r+c/res_typical__cap_typical.spice
.include /home/david/.volare/sky130A/libs.tech/ngspice/r+c/res_typical__cap_typical__lin.spice
.include /home/david/.volare/sky130A/libs.tech/ngspice/corners/tt/specialized_cells.spice

module dac_test_stimulus #(
    parameter WIDTH = 10,
    parameter TESTS_ENABLED = 8'b11111111  // Enable/disable individual tests
) (
    input wire clk,
    input wire rst,
    input wire start,           // Start test sequence
    output reg [WIDTH-1:0] dac_code,
    output reg valid,
    output reg [3:0] current_test,  // Which test is running
    output reg test_done,       // All tests complete
    output reg [7:0] test_progress  // Progress within current test (0-255)
);

    localparam MAX_CODE = (1 << WIDTH) - 1;
    localparam MID_CODE = (1 << (WIDTH-1));
    
    // Test state machine
    typedef enum logic [2:0] {
        IDLE,
        TEST_ZEROS,
        TEST_ONES, 
        TEST_MIDSCALE,
        TEST_RAMP_UP,
        TEST_RAMP_DOWN,
        TEST_ALTERNATING,
        TEST_MAJOR_TRANSITIONS,
        TEST_TRIANGLE,
        DONE
    } test_state_t;
    
    test_state_t state, next_state;
    
    // Test counters
    reg [WIDTH-1:0] counter;
    reg [7:0] hold_count;
    reg [7:0] cycles_per_code;
    reg direction;  // For triangle wave
    
    // State transition
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            state <= IDLE;
            counter <= 0;
            hold_count <= 0;
            direction <= 1;
            current_test <= 0;
            test_done <= 0;
            valid <= 0;
            dac_code <= 0;
            test_progress <= 0;
            cycles_per_code <= 10;  // Default settling time
        end else begin
            case (state)
                IDLE: begin
                    test_done <= 0;
                    valid <= 0;
                    if (start) begin
                        state <= TEST_ZEROS;
                        current_test <= 0;
                        counter <= 0;
                        hold_count <= 0;
                    end
                end
                
                TEST_ZEROS: begin
                    if (TESTS_ENABLED[0]) begin
                        run_zeros_test();
                        if (is_test_complete(100))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_ONES: begin
                    if (TESTS_ENABLED[1]) begin
                        run_ones_test();
                        if (is_test_complete(100))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_MIDSCALE: begin
                    if (TESTS_ENABLED[2]) begin
                        run_midscale_test();
                        if (is_test_complete(100))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_RAMP_UP: begin
                    if (TESTS_ENABLED[3]) begin
                        run_ramp_up_test();
                        if (is_test_complete(MAX_CODE + 1))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_RAMP_DOWN: begin
                    if (TESTS_ENABLED[4]) begin
                        run_ramp_down_test();
                        if (is_test_complete(MAX_CODE + 1))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_ALTERNATING: begin
                    if (TESTS_ENABLED[5]) begin
                        run_alternating_test();
                        if (is_test_complete(200))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_MAJOR_TRANSITIONS: begin
                    if (TESTS_ENABLED[6]) begin
                        run_major_transitions_test();
                        if (is_test_complete(50))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                TEST_TRIANGLE: begin
                    if (TESTS_ENABLED[7]) begin
                        run_triangle_test();
                        if (is_test_complete((MAX_CODE + 1) * 2))
                            advance_to_next_test();
                    end else begin
                        advance_to_next_test();
                    end
                end
                
                DONE: begin
                    valid <= 0;
                    test_done <= 1;
                    if (!start)
                        state <= IDLE;
                end
            endcase
        end
    end
    
    // ========================================================================
    // Test Functions
    // ========================================================================
    
    // Test 0: All Zeros
    task run_zeros_test();
        begin
            if (hold_count == 0) begin
                dac_code <= 0;
                valid <= 1;
                hold_count <= cycles_per_code;
                counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 1: All Ones (Full Scale)
    task run_ones_test();
        begin
            if (hold_count == 0) begin
                dac_code <= MAX_CODE;
                valid <= 1;
                hold_count <= cycles_per_code;
                counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 2: Mid-Scale
    task run_midscale_test();
        begin
            if (hold_count == 0) begin
                dac_code <= MID_CODE;
                valid <= 1;
                hold_count <= cycles_per_code;
                counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 3: Ramp Up (0 to Full Scale)
    task run_ramp_up_test();
        begin
            if (hold_count == 0) begin
                dac_code <= counter[WIDTH-1:0];
                valid <= 1;
                hold_count <= cycles_per_code;
                if (counter < MAX_CODE)
                    counter <= counter + 1;
                else
                    counter <= counter + 1;  // Increment to trigger completion
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 4: Ramp Down (Full Scale to 0)
    task run_ramp_down_test();
        begin
            if (hold_count == 0) begin
                dac_code <= MAX_CODE - counter[WIDTH-1:0];
                valid <= 1;
                hold_count <= cycles_per_code;
                if (counter < MAX_CODE)
                    counter <= counter + 1;
                else
                    counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 5: Alternating 0 and Full Scale
    task run_alternating_test();
        begin
            if (hold_count == 0) begin
                dac_code <= counter[0] ? MAX_CODE : 0;
                valid <= 1;
                hold_count <= cycles_per_code;
                counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 6: Major Code Transitions (for DNL/INL testing)
    task run_major_transitions_test();
        begin
            if (hold_count == 0) begin
                valid <= 1;
                case (counter[4:0])
                    5'd0:  dac_code <= 0;
                    5'd1:  dac_code <= 1;
                    5'd2:  dac_code <= 2;
                    5'd3:  dac_code <= (MAX_CODE >> 3) - 1;  // 1/8 - 1
                    5'd4:  dac_code <= (MAX_CODE >> 3);      // 1/8
                    5'd5:  dac_code <= (MAX_CODE >> 3) + 1;  // 1/8 + 1
                    5'd6:  dac_code <= (MAX_CODE >> 2) - 1;  // 1/4 - 1
                    5'd7:  dac_code <= (MAX_CODE >> 2);      // 1/4
                    5'd8:  dac_code <= (MAX_CODE >> 2) + 1;  // 1/4 + 1
                    5'd9:  dac_code <= (MAX_CODE >> 1) - 1;  // 1/2 - 1
                    5'd10: dac_code <= (MAX_CODE >> 1);      // 1/2
                    5'd11: dac_code <= (MAX_CODE >> 1) + 1;  // 1/2 + 1
                    5'd12: dac_code <= ((MAX_CODE * 3) >> 2) - 1;  // 3/4 - 1
                    5'd13: dac_code <= ((MAX_CODE * 3) >> 2);      // 3/4
                    5'd14: dac_code <= ((MAX_CODE * 3) >> 2) + 1;  // 3/4 + 1
                    5'd15: dac_code <= MAX_CODE - 2;
                    5'd16: dac_code <= MAX_CODE - 1;
                    5'd17: dac_code <= MAX_CODE;
                    default: dac_code <= counter[WIDTH-1:0];
                endcase
                hold_count <= cycles_per_code * 2;  // Hold longer for settling
                counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // Test 7: Triangle Wave
    task run_triangle_test();
        begin
            if (hold_count == 0) begin
                dac_code <= dac_code;  // Will be updated below
                valid <= 1;
                hold_count <= cycles_per_code >> 1;  // Faster for triangle
                
                if (direction) begin
                    // Ramp up
                    if (dac_code < MAX_CODE) begin
                        dac_code <= dac_code + 1;
                    end else begin
                        direction <= 0;
                        dac_code <= dac_code - 1;
                    end
                end else begin
                    // Ramp down
                    if (dac_code > 0) begin
                        dac_code <= dac_code - 1;
                    end else begin
                        direction <= 1;
                        dac_code <= dac_code + 1;
                    end
                end
                counter <= counter + 1;
            end else begin
                hold_count <= hold_count - 1;
            end
        end
    endtask
    
    // ========================================================================
    // Helper Functions
    // ========================================================================
    
    function automatic logic is_test_complete(input integer max_count);
        begin
            test_progress <= (counter * 255) / max_count;
            is_test_complete = (counter >= max_count);
        end
    endfunction
    
    task advance_to_next_test();
        begin
            counter <= 0;
            hold_count <= 0;
            test_progress <= 0;
            current_test <= current_test + 1;
            
            case (state)
                TEST_ZEROS:             state <= TEST_ONES;
                TEST_ONES:              state <= TEST_MIDSCALE;
                TEST_MIDSCALE:          state <= TEST_RAMP_UP;
                TEST_RAMP_UP:           state <= TEST_RAMP_DOWN;
                TEST_RAMP_DOWN:         state <= TEST_ALTERNATING;
                TEST_ALTERNATING:       state <= TEST_MAJOR_TRANSITIONS;
                TEST_MAJOR_TRANSITIONS: state <= TEST_TRIANGLE;
                TEST_TRIANGLE:          state <= DONE;
                default:                state <= DONE;
            endcase
            
            // Print test completion
            $display("[DAC_STIM] Test %0d complete at time %0t", 
                     current_test, $time);
        end
    endtask

endmodule

**** end user architecture code
